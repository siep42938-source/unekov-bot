# ═══════════════════════════════════════════════
#   UNEKOV.HELP — Конфигурация
#   Скопируй этот файл в .env и заполни
# ═══════════════════════════════════════════════

# ── TELEGRAM ─────────────────────────────────
# Получи токен у @BotFather в Telegram:
# 1. Напиши @BotFather
# 2. /newbot
# 3. Введи имя: Unekov Help
# 4. Введи username: unekovhelp_bot (или любой свободный)
# 5. Скопируй токен сюда
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Webhook только для production (оставь пустым для локального запуска)
WEBHOOK_URL=

# ── DATABASE ──────────────────────────────────
# PostgreSQL — установи локально или используй Docker
# Для Docker: оставь как есть
# Для локального PostgreSQL: измени host на localhost
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/osintbot

# Redis — опционально (без него работает in-memory)
REDIS_URL=redis://localhost:6379/0

# ── OPENAI ────────────────────────────────────
# Получи на https://platform.openai.com/api-keys
# Если нет ключа — AI анализ будет отключён, поиск работает
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── SECURITY ──────────────────────────────────
# Любая случайная строка минимум 32 символа
# Можно сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-now-32chars

# ── APP ───────────────────────────────────────
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── ADMIN ─────────────────────────────────────
# Твой Telegram ID (узнай у @userinfobot)
ADMIN_IDS=123456789

# ── TOKENS ────────────────────────────────────
FREE_TOKENS_ON_REGISTER=100
DAILY_FREE_TOKENS=10
